# ==============================================================================
# LinkedPulse Backend Production & Development Configuration (.env)
# ==============================================================================
# Copy this file to .env (cp .env.example .env) and populate with your credentials.
# NEVER commit .env to version control or expose it to client-side bundles!

# ------------------------------------------------------------------------------
# 1. Environment & Server Settings
# ------------------------------------------------------------------------------
# Set to 'production' on live hosts (Render) or 'development' during local testing
ENV=development

# Binding interface ('0.0.0.0' for Render/Docker/Cloud hosts, '127.0.0.1' for local dev)
HOST=0.0.0.0
PORT=8000

# Canonical frontend origin (e.g., https://linkedpulse.onrender.com)
FRONTEND_URL=http://localhost:5173

# Comma-separated list of additional allowed CORS origins (if using multiple domains)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Static frontend assets directory (when serving SPA directly from Python backend)
# STATIC_DIR=../linkedin-post-studio/dist

# ------------------------------------------------------------------------------
# 2. Cryptographic Security & Session Secret
# ------------------------------------------------------------------------------
# CRITICAL: In production (ENV=production), SECRET_KEY is mandatory and MUST be a
# unique, cryptographically random key with at least 32 bytes (64 hex characters).
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_strong_random_secret_key_here

# ------------------------------------------------------------------------------
# 3. Persistent Database Configuration (Dual-Engine: Supabase / SQLite)
# ------------------------------------------------------------------------------
# OPTION A: Supabase Free PostgreSQL (Recommended for ₹0 Render Free Tier)
# If DATABASE_URL is set, LinkedPulse automatically connects to PostgreSQL with SSL.
# Format: postgresql://postgres:[YOUR_PASSWORD]@[DB_HOST]:5432/postgres?sslmode=require
# DATABASE_URL=postgresql://postgres:your_password@db.supabase.co:5432/postgres?sslmode=require

# OPTION B: SQLite Local Database (Default when DATABASE_URL is omitted)
# Used automatically for local development with zero external dependencies.
DATABASE_PATH=linkedpulse.db

# ------------------------------------------------------------------------------
# 4. OpenRouter AI Configuration (Server-Side, Free Models)
# ------------------------------------------------------------------------------
# Obtain your free API key from https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Primary OpenRouter free model (uses free-tier router)
OPENROUTER_MODEL=openrouter/free

# Ordered fallback models if primary model is rate-limited:
OPENROUTER_FALLBACK_MODELS=openrouter/free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3.5-lightning:free,liquid/lfm-2.5-2.6b:free

# ------------------------------------------------------------------------------
# 5. Transactional Email for Password Resets (Render Free Tier)
# ------------------------------------------------------------------------------
# Render free tier blocks outbound SMTP ports (25, 465, 587).
# We use Resend free tier (3,000 emails/month free, port 443 HTTPS REST API).
# Obtain your free key from https://resend.com
# RESEND_API_KEY=re_your_free_resend_api_key_here
# EMAIL_FROM=LinkedPulse <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# 6. LinkedIn OAuth 2.0 & Publishing (Official REST API v202610)
# ------------------------------------------------------------------------------
# Configure in LinkedIn Developer Portal (https://www.linkedin.com/developers/):
# Required Developer Products:
#   1. "Sign In with LinkedIn using OpenID Connect" (Scopes: openid, profile, email)
#   2. "Share on LinkedIn" (Scope: w_member_social)
#
# Production Redirect URI (MUST exactly match registered URI in Developer Portal):
# Example: https://linkedpulse.onrender.com/api/linkedin/callback
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/linkedin/callback
