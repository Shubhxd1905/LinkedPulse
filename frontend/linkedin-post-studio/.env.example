# ==============================================================================
# LinkedPulse Frontend Configuration (.env)
# ==============================================================================
# If your backend API is hosted on a separate origin (e.g., https://api.yourdomain.com),
# set VITE_API_BASE_URL to that origin's API prefix (e.g., https://api.yourdomain.com/api).
# If the frontend and backend are served behind the same reverse proxy (e.g., Nginx),
# leave this unset or set to '/api' for relative path routing.
VITE_API_BASE_URL=/api
